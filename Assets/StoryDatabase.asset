      - speakerName: "\u041B\u0443\u043D\u043D\u044B\u0439 \u043A\u0443\u0437\u043D\u0435\u0446"
        text: "...\u0422\u0440\u0430\u0432\u044F\u043D\u043E\u0439 \u0447\u0430\u0439.
          \u0411\u043E\u043B\u044C\u0448\u043E\u0439. \u0421\u043B\u0435\u0433\u043A\u0430
          \u0441\u043B\u0430\u0434\u043A\u0438\u0439."
        triggerSpeech: 1
      storyRevealLines:
      - speakerName: "\u041C\u0438\u0440\u0430"
        text: "(\u041A \u043B\u0443\u043D\u043D\u043E\u043C\u0443 \u043A\u0443\u0437\u043D\u0435\u0446\u0443,
          \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u0431\u044B\u0447\u043D\u043E
          \u043C\u043E\u043B\u0447\u0438\u0442 \u0432 \u0443\u0433\u043B\u0443.)
          \u0412\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442\u0435 \u0441
          \u043C\u0435\u0442\u0430\u043B\u043B\u043E\u043C. \u041D\u0435 \u0434\u0435\u043B\u0430\u043B\u0438
          \u043B\u0438 \u0432\u044B \u0442\u0430\u043A\u0438\u0445 \u0448\u0435\u0441\u0442\u0435\u0440\u0451\u043D?
          (\u041F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0440\u0438\u0441\u0443\u043D\u043E\u043A.)"
        triggerSpeech: 1
      - speakerName: "\u041B\u0443\u043D\u043D\u044B\u0439 \u043A\u0443\u0437\u043D\u0435\u0446"
        text: "\u0414\u0430. \u041F\u043E \u0437\u0430\u043A\u0430\u0437\u0443 \u0436\u0435\u043D\u0449\u0438\u043D\u044B
          \u0441 \u0448\u0440\u0430\u043C\u043E\u043C. \u042F \u043A\u043E\u0432\u0430\u043B
          \u043C\u043D\u043E\u0433\u043E \u0434\u043B\u044F \u041E\u0440\u0434\u0435\u043D\u0430.
          \u0420\u0430\u043D\u044C\u0448\u0435 \u043D\u0435 \u0437\u043D\u0430\u043B,
          \u0434\u043B\u044F \u0447\u0435\u0433\u043E. \u0422\u0435\u043F\u0435\u0440\u044C
          \u0436\u0430\u043B\u0435\u044E. \u0412\u043E\u0437\u044C\u043C\u0438 \u044D\u0442\u0443
          \u043F\u0435\u0441\u0447\u0438\u043D\u043A\u0443 \u043B\u0443\u043D\u043D\u043E\u0433\u043E
          \u0441\u0435\u0440\u0435\u0431\u0440\u0430. \u041E\u043D\u0430 \u043F\u0440\u0438\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
          \u043B\u043E\u0436\u044C. \u041F\u043E\u043B\u043E\u0436\u0438 \u0432 \u043D\u0430\u043F\u0438\u0442\u043E\u043A
          \u0442\u043E\u043C\u0443, \u043A\u043E\u043C\u0443 \u043D\u0435 \u0434\u043E\u0432\u0435\u0440\u044F\u0435\u0448\u044C.
          \u0415\u0441\u043B\u0438 \u043E\u043D \u0441\u043E\u043B\u0436\u0451\u0442
          \u2014 \u043D\u0430\u043F\u0438\u0442\u043E\u043A \u043F\u043E\u0442\u0435\u043C\u043D\u0435\u0435\u0442."
        triggerSpeech: 1
