      greetingLines:
      - speakerName: "\u0424\u043E\u043D\u0430\u0440\u0449\u0438\u043A"
        speakerNameEn: Lamplighter
        text: "\u0413\u043E\u0440\u044F\u0447\u0438\u0439 \u0448\u043E\u043A\u043E\u043B\u0430\u0434,
          \u0441\u043B\u0430\u0434\u043A\u0438\u0439. \u042F \u0433\u0440\u0435\u044E
          \u043B\u0430\u0434\u043E\u043D\u0438 \u043F\u0435\u0440\u0435\u0434 \u0440\u0430\u0431\u043E\u0442\u043E\u0439
          \u0441 \u043E\u0433\u043D\u0451\u043C."
        textEn: Hot chocolate, sweet. I warm my palms before working with fire.
        triggerSpeech: 1
      - speakerName: "\u041C\u0438\u0440\u0430"
        speakerNameEn: Mira
        text: "\u0412\u044B \u0437\u0430\u0436\u0438\u0433\u0430\u0435\u0442\u0435
          \u0444\u043E\u043D\u0430\u0440\u0438. \u0410 \u0427\u0451\u0440\u043D\u044B\u0439
          \u0424\u043E\u043D\u0430\u0440\u044C \u0441\u043C\u043E\u0436\u0435\u0442\u0435?"
        textEn: You light lanterns. Could you make a Black one?
        triggerSpeech: 1
      wrongOrderLines:
      - speakerName: "\u0424\u043E\u043D\u0430\u0440\u0449\u0438\u043A"
