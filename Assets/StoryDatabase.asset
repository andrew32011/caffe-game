    dayEndText: "\u0427\u0451\u0440\u043D\u044B\u0439 \u0424\u043E\u043D\u0430\u0440\u044C
      \u0443\u043A\u0440\u0430\u0434\u0435\u043D. \u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0435
