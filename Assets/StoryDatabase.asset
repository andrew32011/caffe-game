        speakerNameEn: Echo
        text: "\u041A\u0430\u043F\u0443\u0447\u0438\u043D\u043E. \u0421\u0440\u0435\u0434\u043D\u0438\u0439.
          \u041A\u0430\u043A \u0432\u0441\u0435\u0433\u0434\u0430 \u2014 \u043F\u043E
          \u043E\u0431\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B."
        textEn: "A cappuccino. Medium. As always \u2014 on both sides."
        triggerSpeech: 1
      storyRevealLines:
      - speakerName: "\u042D\u0445\u043E"
