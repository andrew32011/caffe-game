    dayEndText: "\xAB\u0420\u0430\u0437\u0440\u044B\u0432 \u041F\u043E\u043A\u0440\u043E\u0432\u0430\xBB
      \u2014 \u0440\u0438\u0442\u0443\u0430\u043B \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435
      \u043B\u0443\u043D\u043D\u043E\u0435 \u0437\u0430\u0442\u043C\u0435\u043D\u0438\u0435.
      \u041A\u0430\u044F \u043F\u043E\u0445\u0438\u0442\u0438\u043B\u0438 \u0447\u0442\u043E\u0431\u044B
      \u043E\u043D \u043D\u0435 \u043F\u043E\u043C\u0435\u0448\u0430\u043B \u0418\u041B\u0418
      \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043D\u0430 \u043D\u0438\u0445."
    dayEndTextEn: "The Veil Rending \u2014 a ritual at the next lunar eclipse. Kai
      was taken either to keep him from interfering OR to force him to work for them."
