      - speakerName: "\u0417\u0432\u0451\u0437\u0434\u043D\u044B\u0439 \u043F\u0430\u0441\u0442\u0443\u0445"
        text: "\u0414\u0430. \u0418\u0445 \u0430\u043B\u0442\u0430\u0440\u044C \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
          \u0432 \u043C\u0435\u0441\u0442\u0435, \u0433\u0434\u0435 \u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F
