    dayEndText: "\u0421\u0442\u0440\u0430\u043D\u043D\u0438\u043A \u0431\u044B\u043B
      \u043F\u043E\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C \u041E\u0440\u0434\u0435\u043D\u0430.
