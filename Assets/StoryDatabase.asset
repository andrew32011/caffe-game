  - dayNumber: 5
    customers:
    - characterType: 3
      stickmanIndex: 3
      order:
        type: 0
        volume: 0
        sweet: 0
        topping: 0
      greetingLines:
      - speakerName: "\u041C\u0438\u0440\u0430"
        speakerNameEn: Mira
        text: "\u042D\u0441\u043F\u0440\u0435\u0441\u0441\u043E?"
        textEn: Espresso?
