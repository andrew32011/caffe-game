    dayEndText: "\xAB\u0417\u0435\u0440\u043A\u0430\u043B\u044C\u043D\u0430\u044F
      \u0422\u0435\u043C\u043D\u0438\u0446\u0430\xBB \u2014 \u043A\u0430\u0440\u043C\u0430\u043D
      \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0443 \u0423\u0449\u0435\u043B\u044C\u044F.
      \u041D\u0443\u0436\u0435\u043D \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0432\u043E \u0441\u043D\u0430\u0445: \u0421\u043D\u043E\u0432\u0438\u0434\u0438\u0446\u0430
      \u2014 \u0420\u044B\u043D\u043E\u043A \u0422\u0435\u043D\u0435\u0439, \u0437\u0430
      \u0447\u0430\u0441\u0430\u043C\u0438."
    dayEndTextEn: "The Mirror Dungeon is a pocket of reality near the Gorge. You
      need a dream guide: the Dreamweaver \u2014 Shadow Market, behind the clock."
