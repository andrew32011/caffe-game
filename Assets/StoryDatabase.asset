          \u0433\u0434\u0435 \u043F\u0430\u0434\u0430\u0435\u0442 \u0441\u0432\u0435\u0442
          \u043E\u0442 \u0427\u0451\u0440\u043D\u043E\u0433\u043E \u0424\u043E\u043D\u0430\u0440\u044F.
          \u041E\u043D \u0441\u0432\u0435\u0442\u0438\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
          \u0432 \u0431\u0435\u0437\u043B\u0443\u043D\u043D\u0443\u044E \u043D\u043E\u0447\u044C."
        triggerSpeech: 1
    dayEndText: "\u0410\u043B\u0442\u0430\u0440\u044C \u041E\u0440\u0434\u0435\u043D\u0430
      \u2014 \u043C\u0435\u0441\u0442\u043E \u0442\u0440\u0451\u0445 \u0442\u0435\u043D\u0435\u0439.
      \u0418\u0449\u0438 \u0442\u0430\u043C, \u0433\u0434\u0435 \u043F\u0430\u0434\u0430\u0435\u0442
      \u0441\u0432\u0435\u0442 \u043E\u0442 \u0427\u0451\u0440\u043D\u043E\u0433\u043E
      \u0424\u043E\u043D\u0430\u0440\u044F. \u041E\u043D \u0441\u0432\u0435\u0442\u0438\u0442
