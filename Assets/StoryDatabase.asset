    dayEndText: "\u0417\u0435\u0440\u043A\u0430\u043B\u044C\u043D\u044B\u0439 \u0432\u043E\u0440
      \u0434\u0430\u043B \u0442\u0435\u0431\u0435 \u0442\u0440\u0435\u0441\u043D\u0443\u0432\u0448\u0435\u0435
      \u0437\u0435\u0440\u043A\u0430\u043B\u043E. \u0415\u0441\u043B\u0438 \u0443\u0432\u0438\u0434\u0438\u0448\u044C
      \u0436\u0435\u043D\u0449\u0438\u043D\u0443 \u0441 \u0448\u0440\u0430\u043C\u043E\u043C-\u043C\u043E\u043B\u043D\u0438\u0435\u0439
