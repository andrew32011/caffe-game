        text: "\u0421\u043B\u0430\u0434\u043A\u0438\u0439 \u0433\u043E\u0440\u044F\u0447\u0438\u0439
          \u0448\u043E\u043A\u043E\u043B\u0430\u0434, \u0441\u0440\u0435\u0434\u043D\u0438\u0439."
        textEn: A sweet hot chocolate, medium.
        triggerSpeech: 1
      storyRevealLines:
      - speakerName: "\u0424\u043E\u043D\u0430\u0440\u0449\u0438\u043A"
        speakerNameEn: Lamplighter
        text: "\u0427\u0451\u0440\u043D\u044B\u0439 \u0424\u043E\u043D\u0430\u0440\u044C
          \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043C\u0435\u0441\u0442\u0430
          \u0441\u0438\u043B\u044B \u041E\u0440\u0434\u0435\u043D\u0430. \u042F \u0432\u044B\u043A\u0443\u044E
          \u043D\u043E\u0432\u044B\u0439 \u2014 \u043D\u043E \u043D\u0443\u0436\u043D\u043E
          \u043D\u0435\u0433\u0430\u0441\u0438\u043C\u043E\u0435 \u043F\u043B\u0430\u043C\u044F.
          \u041F\u043E\u043F\u0440\u043E\u0441\u0438 \u043E\u0433\u043D\u0435\u043D\u043D\u043E\u0433\u043E
          \u0430\u043B\u0445\u0438\u043C\u0438\u043A\u0430; \u043E\u043D \u0443 \u0442\u0435\u0431\u044F
          \u0432 \u0434\u043E\u043B\u0433\u0443."
        textEn: "The Black Lantern reveals the Order's places of power. I'll forge
          a new one \u2014 but I need an undying flame. Ask the Fire Alchemist; he
          is in your debt."
        triggerSpeech: 1
