      greetingLines:
      - speakerName: "\u0422\u0440\u0430\u0432\u043D\u0438\u0446\u0430"
        speakerNameEn: Herbalist
        text: "\u0422\u0440\u0430\u0432\u044F\u043D\u043E\u0439, \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439,
          \u043F\u043E\u0441\u043B\u0430\u0449\u0435. \u0418 \u0434\u043E\u0431\u0430\u0432\u044C
          \u0442\u043E, \u0447\u0442\u043E \u044F \u043F\u043E\u043B\u043E\u0436\u0443.
          (\u041A\u043B\u0430\u0434\u0451\u0442 \u0449\u0435\u043F\u043E\u0442\u044C
          \u0441\u0443\u0445\u0438\u0445 \u0446\u0432\u0435\u0442\u043E\u0432.)"
        textEn: Herbal, small, a bit sweet. And add what I give you. (Drops in a
          pinch of dried flowers.)
        triggerSpeech: 1
      - speakerName: "\u041C\u0438\u0440\u0430"
        speakerNameEn: Mira
        text: "\u0427\u0442\u043E \u044D\u0442\u043E?"
        textEn: What is this?
        triggerSpeech: 1
      wrongOrderLines:
      - speakerName: "\u0422\u0440\u0430\u0432\u043D\u0438\u0446\u0430"
        speakerNameEn: Herbalist
        text: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u0442\u0440\u0430\u0432\u044F\u043D\u043E\u0439.
          \u0421\u0440\u0435\u0434\u043D\u0435 \u0441\u043B\u0430\u0434\u043A\u0438\u0439.
          \u0421 \u043C\u043E\u0438\u043C\u0438 \u0446\u0432\u0435\u0442\u0430\u043C\u0438."
        textEn: A small herbal. Medium sweet. With my flowers.
        triggerSpeech: 1
      storyRevealLines:
      - speakerName: "\u0422\u0440\u0430\u0432\u043D\u0438\u0446\u0430"
        speakerNameEn: Herbalist
        text: "\u0421\u043E\u043D-\u0442\u0440\u0430\u0432\u0430. \u0412\u044B\u043F\u044C\u0435\u0448\u044C
          \u043F\u0435\u0440\u0435\u0434 \u0441\u043D\u043E\u043C \u2014 \u043F\u043E\u0439\u0434\u0451\u0448\u044C
          \u0432\u043E \u0441\u043D\u0435 \u0442\u0443\u0434\u0430, \u043A\u0443\u0434\u0430
          \u0437\u043E\u0432\u0451\u0442 \u0441\u0435\u0440\u0434\u0446\u0435. \u041D\u0430\u0439\u0434\u0438
          \u041A\u0430\u044F. \u041D\u043E \u043D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0441\u044F:
          \u0432\u043E \u0441\u043D\u0435 \u041E\u0440\u0434\u0435\u043D \u0442\u043E\u0436\u0435
          \u043D\u0435 \u0441\u043F\u0438\u0442."
        textEn: "Dreamgrass. Drink it before sleep \u2014 and you'll walk in dream
          to where your heart calls. Find Kai. But don't linger: in dreams the Order
          doesn't sleep either."
        triggerSpeech: 1
    - characterType: 0
      stickmanIndex: 5
