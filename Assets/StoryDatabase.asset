        text: "\u041A\u0430\u043F\u0443\u0447\u0438\u043D\u043E. \u042F \u043F\u044C\u044E
          \u0435\u0433\u043E \u0438 \u043F\u043E \u0442\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
          \u0437\u0435\u0440\u043A\u0430\u043B\u0430 \u2014 \u0432 \u043E\u0434\u0438\u043D
          \u0438 \u0442\u043E\u0442 \u0436\u0435 \u043C\u0438\u0433."
        textEn: "A cappuccino. I drink it on the other side of the mirror too \u2014
          at the very same moment."
        triggerSpeech: 1
      - speakerName: "\u041C\u0438\u0440\u0430"
        speakerNameEn: Mira
        text: "\u0412\u044B\u2026 \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0435?"
        textEn: "Are you\u2026 a reflection?"
        triggerSpeech: 1
